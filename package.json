{
  "name": "@mivama/ui",
  "version": "3.0.0",
  "description": "Shared Mivama design tokens and React UI primitives.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/components/mivama-provider.d.ts",
      "import": "./dist/components/mivama-provider.js",
      "default": "./dist/components/mivama-provider.js"
    },
    "./button": {
      "types": "./dist/components/ui/button.d.ts",
      "import": "./dist/components/ui/button.js",
      "default": "./dist/components/ui/button.js"
    },
    "./dialog": {
      "types": "./dist/components/ui/dialog.d.ts",
      "import": "./dist/components/ui/dialog.js",
      "default": "./dist/components/ui/dialog.js"
    },
    "./sheet": {
      "types": "./dist/components/ui/sheet.d.ts",
      "import": "./dist/components/ui/sheet.js",
      "default": "./dist/components/ui/sheet.js"
    },
    "./tooltip": {
      "types": "./dist/components/ui/tooltip.d.ts",
      "import": "./dist/components/ui/tooltip.js",
      "default": "./dist/components/ui/tooltip.js"
    },
    "./card": {
      "types": "./dist/components/ui/card.d.ts",
      "import": "./dist/components/ui/card.js",
      "default": "./dist/components/ui/card.js"
    },
    "./scroll-scene": {
      "types": "./dist/components/ui/scroll-scene.d.ts",
      "import": "./dist/components/ui/scroll-scene.js",
      "default": "./dist/components/ui/scroll-scene.js"
    },
    "./bento-grid": {
      "types": "./dist/components/ui/bento-grid.d.ts",
      "import": "./dist/components/ui/bento-grid.js",
      "default": "./dist/components/ui/bento-grid.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.js",
      "default": "./dist/forms.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./themes.css": "./dist/themes.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/*.css dist/ && cp -R src/fonts dist/",
    "sync:imports": "node scripts/fix-shadcn-imports.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "pack:check": "node scripts/check-packed-package.mjs",
    "verify": "npm run audit:source && npm run typecheck && npm run build && npm test && npm run pack:check",
    "prepublishOnly": "npm run verify",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "tailwindcss": ">=4 <5"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7"
  }
}
