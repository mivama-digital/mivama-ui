{
  "name": "@mivama/ui",
  "version": "0.1.0",
  "description": "Shared Mivama UI components built with React, shadcn/ui and Tailwind CSS.",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.6.0",
    "class-variance-authority": ">=0.7.1",
    "clsx": ">=2.1.1",
    "lucide-react": ">=0.500.0",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwind-merge": ">=3.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "lucide-react": "^0.511.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5"
  }
}
